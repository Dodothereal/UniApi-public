# --- Secrets. Nothing in this block may ever be tracked. -------------------
# providers.json holds live API keys in plain text by design (free-tier keys,
# copyable in the UI). The tracked stand-in is providers.example.json, which
# tools/make_providers_example.py regenerates from it with every key blanked.
# The server creates providers.json from the example on first start.
providers.json
providers.json.lock
providers.json.native-lock
# Generated by t3code/gen_t3code_settings.py; full of absolute home paths and
# one settings file per provider.
t3code/userdata/settings.json
# Runtime content hash for the optional T3 Code provider-sync watcher. It is
# rewritten whenever Switcher changes a provider default.
t3code/.sync-hash
# Local overrides and anything a contributor keeps beside the config.
providers.local.json
*.local.json
.env
.env.*
!.env.example
*.pem
*.key

# --- The Arena's results ledger --------------------------------------------
# One JSON file per judged match. They are shared through the dedicated
# `arena-results` branch (the Arena's Publish and Sync buttons write it with
# git plumbing); on every other branch they are local data, never committed.
arena/results/*.json

# --- Build output and runtime state ----------------------------------------
ApiBench.app/
UniApi.app/
data/
data/bench/
node_modules/
client/dist/
*.tsbuildinfo
build.noindex/
shell/build.noindex/
dist/
__pycache__/
*.pyc
native/swift/.build/
native/swift/.swiftpm/
native/swift/.cache/
/.cache/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
